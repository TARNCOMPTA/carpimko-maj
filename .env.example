# Copier ce fichier en ".env" et adapter les valeurs.

# Port du serveur web local
PORT=3002

# Cle maitre de chiffrement des mots de passe clients (AES-256-GCM).
# DOIT etre une chaine hexadecimale de 64 caracteres (32 octets).
# Generer une cle avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# /!\ Si tu changes cette cle, les mots de passe deja enregistres deviennent illisibles.
MASTER_KEY=remplace_moi_par_une_cle_hex_de_64_caracteres

# "true" (defaut) : fonctionnement invisible, la fenetre du navigateur ne s'affiche pas.
# Mettre "false" uniquement pour voir le navigateur (debug / double authentification au 1er run).
HEADLESS=true

# URL de la page de connexion de l'espace personnel CARPIMKO (verifiee le 10/06/2026).
CARPIMKO_LOGIN_URL=https://www2.carpimko.com/Comptes/Connexion?ReturnUrl=%2F

# Delai max (ms) d'attente des elements de page
NAV_TIMEOUT=45000

# false = ne recuperer que les appels de cotisations (defaut).
# true  = recuperer TOUS les documents (attestations comprises).
TOUS_DOCUMENTS=false
